{
  "info": {
    "_postman_id": "real-estate-kong-api-v2",
    "name": "Real Estate API (Kong Gateway)",
    "description": "Real Estate Application API collection for Kong Gateway integration.\n\n## Setup\n1. Import this collection into Postman\n2. Import the environment file (Real_Estate_Kong_Environment.postman_environment.json)\n3. Select the environment before running requests\n\n## Authentication Flow\n1. Register a new user or login with existing credentials\n2. The access token will be automatically saved to the environment\n3. Protected endpoints will use the saved token\n\n## Rate Limits\n- Auth endpoints: 10 requests/minute\n- API endpoints: 100 requests/minute",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "kong_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Kong Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_url}}/actuator/health",
              "host": ["{{kong_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Check Kong Gateway health status"
          }
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_url}}/auth/actuator/health",
              "host": ["{{kong_url}}"],
              "path": ["auth", "actuator", "health"]
            },
            "description": "Check Auth Service health via Kong"
          }
        },
        {
          "name": "JWKS Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_url}}/.well-known/jwks.json",
              "host": ["{{kong_url}}"],
              "path": [".well-known", "jwks.json"]
            },
            "description": "Get JSON Web Key Set for JWT validation"
          }
        }
      ],
      "description": "Health check endpoints for monitoring service status"
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "        console.log('Access token saved');",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "        console.log('Refresh token saved');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Registration successful or user exists', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"TestPassword123\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/auth/register",
              "host": ["{{kong_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user account.\n\nPassword requirements:\n- Minimum 8 characters (12 in production)\n- At least one uppercase letter\n- At least one lowercase letter\n- At least one digit"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "        console.log('Access token saved');",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "        console.log('Refresh token saved');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Login successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has tokens', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('accessToken');",
                  "    pm.expect(jsonData).to.have.property('refreshToken');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"TestPassword123\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/auth/login",
              "host": ["{{kong_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user and receive JWT tokens.\n\nRate limit: 10 requests/minute"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.collectionVariables.set('access_token', jsonData.accessToken);",
                  "        console.log('New access token saved');",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "        console.log('New refresh token saved');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Token refresh successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/auth/refresh",
              "host": ["{{kong_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Refresh access token using refresh token.\n\nRefresh tokens are rotated on each use for security."
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get user successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has user data', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kong_url}}/auth/me",
              "host": ["{{kong_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Get current authenticated user information.\n\nRequires valid JWT token."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"currentPassword\": \"TestPassword123\",\n    \"newPassword\": \"NewPassword456\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/auth/change-password",
              "host": ["{{kong_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Change password for authenticated user.\n\nRequires valid JWT token and current password."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"testuser@example.com\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/auth/forgot-password",
              "host": ["{{kong_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Request password reset email.\n\nA reset token will be sent to the provided email address."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"token\": \"reset-token-from-email\",\n    \"newPassword\": \"NewPassword789\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/auth/reset-password",
              "host": ["{{kong_url}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Reset password using token from email.\n\nToken expires after 1 hour."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kong_url}}/auth/logout",
              "host": ["{{kong_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout and invalidate refresh token.\n\nRequires valid JWT token."
          }
        }
      ],
      "description": "Authentication endpoints for user registration, login, and token management.\n\nAll auth endpoints have a rate limit of 10 requests/minute."
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "List Properties (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get properties successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is array or paginated', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.satisfy(function(data) {",
                  "        return Array.isArray(data) || data.hasOwnProperty('content');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_url}}/api/properties?page=0&size=10",
              "host": ["{{kong_url}}"],
              "path": ["api", "properties"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
