                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_url}}/api/properties/cities",
              "host": ["{{kong_url}}"],
              "path": ["api", "properties", "cities"]
            },
            "description": "Get list of all cities with properties.\n\nPublic endpoint - no authentication required."
          }
        },
        {
          "name": "Get My Properties",
