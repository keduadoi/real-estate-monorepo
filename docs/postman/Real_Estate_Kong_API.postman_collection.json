    {
      "name": "Testing",
      "item": [
        {
          "name": "Test Rate Limiting",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check rate limit headers",
                  "pm.test('Rate limit headers present', function() {",
                  "    pm.expect(pm.response.headers.has('X-RateLimit-Limit-Minute')).to.be.true;",
                  "    pm.expect(pm.response.headers.has('X-RateLimit-Remaining-Minute')).to.be.true;",
                  "});",
                  "",
                  "var remaining = pm.response.headers.get('X-RateLimit-Remaining-Minute');",
                  "console.log('Rate limit remaining: ' + remaining);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_url}}/api/properties/cities",
              "host": ["{{kong_url}}"],
              "path": ["api", "properties", "cities"]
            },
            "description": "Test rate limiting headers.\n\nCheck X-RateLimit-Limit-Minute and X-RateLimit-Remaining-Minute headers."
          }
        },
        {
          "name": "Test CORS (Preflight)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('CORS headers present', function() {",
                  "    pm.expect(pm.response.headers.has('Access-Control-Allow-Origin')).to.be.true;",
