            "description": "Get properties owned by the authenticated user.\n\nRequires valid JWT token."
          }
        },
        {
          "name": "Create Property",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('property_id', jsonData.id);",
                  "        console.log('Property ID saved: ' + jsonData.id);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Property created', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Beautiful Apartment in District 1\",\n    \"description\": \"Modern 2-bedroom apartment with city view\",\n    \"price\": 250000,\n    \"area\": 75.5,\n    \"bedrooms\": 2,\n    \"bathrooms\": 2,\n    \"propertyType\": \"APARTMENT\",\n    \"listingType\": \"SALE\",\n    \"address\": \"123 Nguyen Hue Street\",\n    \"city\": \"Ho Chi Minh\",\n    \"district\": \"District 1\",\n    \"ward\": \"Ben Nghe\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/api/properties",
              "host": ["{{kong_url}}"],
              "path": ["api", "properties"]
            },
            "description": "Create a new property listing.\n\nRequires valid JWT token.\n\nProperty types: APARTMENT, HOUSE, VILLA, LAND, OFFICE\nListing types: SALE, RENT"
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Updated: Beautiful Apartment in District 1\",\n    \"description\": \"Modern 2-bedroom apartment with stunning city view - UPDATED\",\n    \"price\": 275000,\n    \"area\": 75.5,\n    \"bedrooms\": 2,\n    \"bathrooms\": 2,\n    \"propertyType\": \"APARTMENT\",\n    \"listingType\": \"SALE\",\n    \"address\": \"123 Nguyen Hue Street\",\n    \"city\": \"Ho Chi Minh\",\n    \"district\": \"District 1\",\n    \"ward\": \"Ben Nghe\"\n}"
            },
            "url": {
              "raw": "{{kong_url}}/api/properties/{{property_id}}",
              "host": ["{{kong_url}}"],
              "path": ["api", "properties", "{{property_id}}"]
            },
            "description": "Update an existing property.\n\nRequires valid JWT token.\nOnly the property owner can update."
          }
        },
        {
          "name": "Delete Property",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kong_url}}/api/properties/{{property_id}}",
              "host": ["{{kong_url}}"],
              "path": ["api", "properties", "{{property_id}}"]
            },
            "description": "Delete a property listing.\n\nRequires valid JWT token.\nOnly the property owner can delete."
          }
        }
      ],
      "description": "Property management endpoints.\n\nPublic endpoints (GET) have no authentication.\nProtected endpoints (POST, PUT, DELETE) require JWT token."
    },
    {
